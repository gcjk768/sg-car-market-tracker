# Copy this file to .env and fill in the values. Never commit .env.
TELEGRAM_BOT_TOKEN=123456789:replace_with_the_token_from_botfather
TELEGRAM_CHAT_ID=123456789
# Optional. Shown in the User Agent so site owners can reach you.
SCRAPER_CONTACT=you@example.com
# Optional, only when ai.enabled is true in config.yaml. Create it with `claude setup-token`
# on a machine where you are logged in to Claude Code, or set ANTHROPIC_API_KEY instead.
# CLAUDE_CODE_OAUTH_TOKEN=
