# Copy this file to .env and fill in the values. Never commit .env.
# Optional. Shown in the User Agent so site owners can reach you.
SCRAPER_CONTACT=you@example.com
# Optional. The easiest way to sign the Claude CLI in is from the container terminal:
#   docker compose exec -it sg-car-scraper claude auth login
# The login is kept in data/claude on the host. Alternatively paste a token from
# `claude setup-token`, or set ANTHROPIC_API_KEY instead.
# CLAUDE_CODE_OAUTH_TOKEN=
# Optional. Host folder of the Obsidian vault the tracker writes its movement log to, mounted at /vault.
# VAULT_HOST_DIR=/volume1/<USER>/Obsidian/SG Car Market
