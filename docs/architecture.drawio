44" as="geometry" /></mxCell><mxCell id="sc_fuel" value="Pump prices: Motorist board&#xa;(fuel_price.py)" style="rounded=1;html=0;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#4A7BD0;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="464" width="210" height="40" as="geometry" /></mxCell><mxCell id="sc_used" value="Used cars: Sgcarmart, Motorist&#xa;(used_sgcarmart, used_motorist)" style="rounded=1;html=0;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#4A7BD0;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="512" width="210" height="40" as="geometry" /></mxCell><mxCell id="sc_new" value="New EV price list and full new&#xa;car list: Sgcarmart&#xa;(new_ev.py, new_cars.py)" style="rounded=1;html=0;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#4A7BD0;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="560" width="210" height="54" as="geometry" /></mxCell><mxCell id="sc_off" value="Official brand prices:&#xa;scrapers/official, one module&#xa;per brand (BYD, Kia, BMW,&#xa;Lexus, VW, Porsche and others),&#xa;plain HTML, PDF or headless&#xa;Chromium" style="rounded=1;html=0;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#4A7BD0;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="622" width="210" height="96" as="geometry" /></mxCell><mxCell id="sc_reg" value="LTA registrations: M03 cars,&#xa;M04 bikes (registrations.py)" style="rounded=1;html=0;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#4A7BD0;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="726" width="210" height="44" as="geometry" /></mxCell><mxCell id="sc_bike" value="SGBikemart used bikes&#xa;(motorbikes.py, at site build)" style="rounded=1;html=0;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#4A7BD0;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="778" width="210" height="44" as="geometry" /></mxCell><mxCell id="pipe" value="pipeline.py&#xa;runs each section's scrapers;&#xa;a failed source marks only&#xa;its section unavailable" style="rounded=1;html=0;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;arcSize=8;strokeColor=#4A7BD0;" vertex="1" parent="1"><mxGeometry x="825" y="390" width="230" height="80" as="geometry" /></mxCell><mxCell id="db" value="SQLite data/cars.db&#xa;COE, prices, listings,&#xa;price history, news" style="label;html=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fillColor=#FFFFFF;strokeColor=#4A7BD0;image=data:image/svg+xml,;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=50;align=left;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1100" y="390" width="230" height="80" as="geometry" /></mxCell><mxCell id="official" value="official.py&#xa;matches official prices to&#xa;variants, adds COE where a&#xa;price leaves it out" style="rounded=1;html=0;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;arcSize=8;strokeColor=#4A7BD0;" vertex="1" parent="1"><mxGeometry x="825" y="520" width="230" height="80" as="geometry" /></mxCell><mxCell id="website" value="website.py&#xa;builds the site data: cards,&#xa;costs, COE forecast, bikes" style="rounded=1;html=0;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;arcSize=8;strokeColor=#4A7BD0;" vertex="1" parent="1"><mxGeometry x="1100" y="520" width="230" height="80" as="geometry" /></mxCell><mxCell id="datajson" value="data/site/data.json&#xa;written atomically" style="shape=cylinder3;html=0;fontFamily=Helvetica;fontSize=12;boundedLbl=1;size=10;fillColor=#FFFFFF;strokeColor=#4A7BD0;" vertex="1" parent="1"><mxGeometry x="1375" y="520" width="220" height="80" as="geometry" /></mxCell><mxCell id="config" value="config.yaml&#xa;filters, cost formulas and&#xa;schedules, each block with&#xa;a verified_on date" style="shape=note;html=0;fontFamily=Helvetica;fontSize=12;size=14;fillColor=#FFF8