        <mxCell id="s_sgcm" value="Sgcarmart&#xa;used listings, new cars, COE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="srcbox"><mxGeometry x="20" y="105" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="s_carro" value="Carro (JavaScript app)&#xa;used listings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="srcbox"><mxGeometry x="20" y="170" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="s_moto" value="Motorist&#xa;used listings, COE, petrol prices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="srcbox"><mxGeometry x="20" y="235" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="s_brand" value="Brand price pages&#xa;BYD, Tesla, MG, Aion, Xpeng ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="srcbox"><mxGeometry x="20" y="300" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="s_fuel" value="petrolprice.sg&#xa;fuel price fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="srcbox"><mxGeometry x="20" y="365" width="220" height="50" as="geometry"/></mxCell>

        <mxCell id="scrbox" value="scrapers/" style="swimlane;html=1;startSize=26;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="300" height="470" as="geometry"/></mxCell>
        <mxCell id="base" value="base.py&#xa;fetch with retry and backoff, robots.txt check,&#xa;per domain throttle with jitter,&#xa;daily page cache data/cache/YYYY-MM-DD/,&#xa;Playwright Chromium for rendered pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;" vertex="1" parent="scrbox"><mxGeometry x="20" y="40" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="sc_coe" value="coe.py&#xa;OneMotoring, then Sgcarmart, then Motorist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="scrbox"><mxGeometry x="20" y="145" width="260" height="45" as="geometry"/></mxCell>
        <mxCell id="sc_used" value="used_common.py + used_sgcarmart.py,&#xa;used_carro.py, used_motorist.py&#xa;label based detail parsing, EV and ICE searches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="scrbox"><mxGeometry x="20" y="200" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="sc_new" value="new_ev.py&#xa;model pages, variants, body type,&#xa;brand page price cross check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="scrbox"><mxGeometry x="20" y="270" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="sc_fuel" value="fuel_price.py&#xa;95 octane per brand, median feeds costs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="scrbox"><mxGeometry x="20" y="340" width="260" height="45" as="geometry"/></mxCell>
        <mxCell id="sc_parse" value="parse_utils.py&#xa;money, km, dates, years, label and table readers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="scrbox"><mxGeometry x="20" y="395" width="260" height="45" as="geometry"/></mxCell>

        <mxCell id="corebox" value="Core" style="swimlane;html=1;startSize=26;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="70" width="300" height="470" as="geometry"/></mxCell>
        <mxCell id="pipeline" value="pipeline.py&#xa;runs each scraper in isolation,&#xa;marks a failed section unavailable,&#xa;upserts results, builds the 7 sections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="corebox"><mxGeometry x="20" y="40" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="db" value="db.py, SQLite data/cars.db&#xa;runs, coe_results, new_ev_prices,&#xa;used_listings, price_history, fuel_prices&#xa;(idempotent upserts, first_seen, last_seen)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="corebox"><mxGeometry x="20" y="130" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="filters" value="filters.py&#xa;price, mileage per year, owners, COE left,&#xa;age, keyword exclusions, service history bonus,&#xa;ranking, NEW and DROP tags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="corebox"><mxGeometry x="20" y="240" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="costs" value="costs.py&#xa;road tax (6 monthly formulas), PARF schedules,&#xa;ARF tiers, depreciation, energy, insurance bands,&#xa;financing (MAS LTV, flat rate instalments)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="corebox"><mxGeometry x="20" y="330" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="models" value="models.py, pydantic records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="corebox"><mxGeometry x="20" y="420" width="260" height="35" as="geometry"/></mxCell>

        <mxCell id="outbox" value="Output" style="swimlane;html=1;startSize=26;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="280" height="300" as="geometry"/></mxCell>
        <mxCell id="report" value="report.py&#xa;7 sections as Telegram HTML,&#xa;fixed width tables in pre blocks,&#xa;numbered link lists, rich console for dry runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="outbox"><mxGeometry x="20" y="40" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="tg" value="telegram_bot.py&#xa;sendMessage, parse_mode HTML,&#xa;4096 character split with balanced pre blocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="outbox"><mxGeometry x="20" y="135" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="phone" value="Telegram chat&#xa;summary, COE, new EV, used EV,&#xa;used ICE, costs, considerations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;" vertex="1" parent="outbox"><mxGeometry x="20" y="215" width="240" height="65" as="geometry"/></mxCell>

