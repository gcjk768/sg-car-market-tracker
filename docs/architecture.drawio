s,&#xa;Straits Times Singapore" style="rounded=1;html=0;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;arcSize=8;strokeColor=#8A96A8;" vertex="1" parent="1"><mxGeometry x="45" y="361" width="230" height="70" as="geometry" /></mxCell><mxCell id="e_s_rss" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.4357;" edge="1" parent="1" source="s_rss" target="fetch"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s_sgc" value="Sgcarmart&#xa;used listings, new EV price list,&#xa;full new car list, COE fallback" style="rounded=1;html=0;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;arcSize=8;strokeColor=#8A96A8;" vertex="1" parent="1"><mxGeometry x="45" y="443" width="230" height="70" as="geometry" /></mxCell><mxCell id="e_s_sgc" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5628;" edge="1" parent="1" source="s_sgc" target="fetch"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s_brand" value="Brand websites (21 brands)&#xa;BYD, Kia, BMW, Lexus, VW,&#xa;Porsche and others" style="rounded=1;html=0;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;arcSize=8;strokeColor=#8A96A8;" vertex="1" parent="1"><mxGeometry x="45" y="525" width="230" height="70" as="geometry" /></mxCell><mxCell id="e_s_brand" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.6899;" edge="1" parent="1" source="s_brand" target="fetch"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s_bike" value="SGBikemart&#xa;used bikes by licence class" style="