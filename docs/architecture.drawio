-MM-DD" style="shape=cylinder3;html=0;fontFamily=Helvetica;fontSize=12;boundedLbl=1;size=10;fillColor=#FFFFFF;strokeColor=#4A7BD0;" vertex="1" parent="1"><mxGeometry x="360" y="795" width="150" height="80" as="geometry" /></mxCell><mxCell id="e_cache" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="fetch" target="cache"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sched" value="scheduler.py&#xa;Docker entry, daily 08:00,&#xa;retries, watchdog,&#xa;heartbeat healthcheck" style="label;html=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fillColor=#FFFFFF;strokeColor=#4A7BD0;image=data:image/svg+xml,;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=50;align=left;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="550" y="115" width="230" height="80" as="geometry" /></mxCell><mxCell id="heal" value="heal.py&#xa;self repair after a second&#xa;failure, kept only when the&#xa;tests and a dry run pass" style="rounded=1;html=0;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;arcSize=8;strokeColor=#4A7BD0;" vertex="1" parent="1"><mxGeometry x="825" y="115" width="230" height="80" as="geometry" /></mxCell><mxCell id="claude" value="Claude CLI (claude -p)&#xa;self repair, used car red&#xa;flags, missing listing fields" style="label;html=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fillColor=#FFFFFF;strokeColor=#D97757;image=data:image/svg+xml,;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=50;align=left;rounded=1;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1100" y="115" width="230" height="80" as="geometry" /></mxCell><mxCell id="vaultpy" value="vault.py&#xa;movement log of every&#xa;process, one alert a day" style="rounded=1;html=0;fontFamily=Helvetica;font